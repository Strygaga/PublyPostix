# ==========================================
# PublyPostix: Environment Variables Template
# ==========================================

# --- Telegram Bot API ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Database Credentials (PostgreSQL 16) ---
POSTGRES_DB=publypostix
POSTGRES_USER=publy_admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

# --- n8n Orchestrator ---
N8N_PORT=5678
N8N_ENCRYPTION_KEY=your_random_32_character_encryption_key
WEBHOOK_URL=https://your-ngrok-or-domain.dev

# --- Meta for Developers (Instagram Graph API) ---
META_CLIENT_ID=your_meta_app_client_id
META_CLIENT_SECRET=your_meta_app_client_secret

# --- VK ID (OAuth 2.1) ---
VK_CLIENT_ID=your_vk_app_id
VK_CLIENT_SECRET=your_vk_service_token_or_client_secret