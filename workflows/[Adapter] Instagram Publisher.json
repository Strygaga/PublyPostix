    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({\n  json: {\n    success: true,\n    platform_post_id: $('[Meta] Publish Story').item.json.id\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
