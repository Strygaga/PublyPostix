      ],
      "id": "bff3991a-7b0b-4148-8f3b-596097adb361",
      "name": "[Logic] Return Success"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const err = item.json;\n  let message = 'Ошибка публикации Stories в Instagram';\n\n  if (err.error?.message) {\n    message = err.error.message;\n  } else if (err.errorMessage) {\n    message = err.errorMessage;\n  } else if (err.status_code === 'ERROR') {\n    message = 'Серверы Meta отклонили медиафайл (проверьте пропорции 9:16 и битрейт)';\n  } else if (err.status_code === 'IN_PROGRESS') {\n    message = 'Превышено время ожидания кодирования видео на серверах Meta';\n  }\n\n  return {\n    json: {\n      success: false,\n      error_message: message\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
