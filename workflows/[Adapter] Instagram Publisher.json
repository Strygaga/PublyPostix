    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const payload = item.json;\n  const firstMedia = payload.items?.[0] || {};\n\n  return {\n    json: {\n      chat_id: payload.chat_id,\n      internal_platform_id: payload.internal_platform_id,\n      platform_user_id: payload.platform_user_id,\n      access_token: payload.access_token,\n      file_id: firstMedia.file_id || payload.file_id,\n      incoming_type: firstMedia.type || payload.incoming_type || 'photo',\n      caption: payload.caption || '',\n      draft_data: {\n        target_platform: 'instagram',\n        target_format: payload.format || 'stories'\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        928
      ],
